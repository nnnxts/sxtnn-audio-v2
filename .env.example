# Copiez ce fichier en ".env" pour le développement local (facultatif).
# Sur Railway, ces variables se règlent dans l'onglet "Variables" du service.

# Port du serveur (Railway le fournit automatiquement)
PORT=3000

# Dossier de stockage de TOUTES les données modifiables (base + fichiers).
# En local : ./data      Sur Railway : /data (chemin de montage du Volume)
DATA_DIR=./data

# Secret de signature des connexions. Facultatif : s'il est absent, le serveur
# en génère un et le sauvegarde dans DATA_DIR/.jwt_secret (il survit aux redémarrages).
# JWT_SECRET=mettez-une-longue-phrase-aleatoire-ici

# Mot de passe pour télécharger / restaurer un backup depuis /distro (recommandé en ligne).
# Sans lui, la restauration est désactivée sur Railway.
# ADMIN_KEY=choisissez-un-mot-de-passe-long
