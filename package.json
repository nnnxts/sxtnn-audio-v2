{
  "name": "sxtnn-audio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SXTNN AUDIO (streaming) + SXTNN DISTRO (distribution) - monorepo unifié pour Railway",
  "engines": {
    "node": "20.x || 22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "compression": "^1.7.5",
    "express": "^4.21.1",
    "framer-motion": "^11.11.17",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.460.0",
    "multer": "^2.0.0",
    "music-metadata": "^10.6.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "unzipper": "^0.12.3",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0"
  }
}
